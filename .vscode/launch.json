{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Abrir sitio en Render",
            "url": "https://inmobiliaria-main.onrender.com",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "InmobiliariaApplication",
            "request": "launch",
            "mainClass": "com.example.inmobiliaria.InmobiliariaApplication",
            "projectName": "inmobiliaria",
            "preLaunchTask": "Maven compile (wrapper)"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}